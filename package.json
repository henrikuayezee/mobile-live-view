{
  "name": "mobile-live-view",
  "version": "1.0.1",
  "private": true,
  "description": "See and control an Android phone from your Windows PC, over Wi-Fi or USB.",
  "author": "Henry Quayezee",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "fetch-scrcpy-server": "node scripts/fetch-scrcpy-server.js",
    "fetch-adb": "node scripts/fetch-adb.js",
    "start": "node src/server/index.js",
    "electron": "electron .",
    "postinstall": "node scripts/postinstall.js",
    "predist": "npm run fetch-scrcpy-server && npm run fetch-adb",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.henryquayezee.mobileliveview",
    "productName": "Mobile Live View",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "*.jar",
          "platform-tools/**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Mobile-Live-View-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
