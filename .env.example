# Copy to .env and adjust for your machine.

# Explicit adb binary to use. If unset, falls back to "adb" on PATH,
# then to ADB_FALLBACK_PATH below.
# ADB_PATH=

# Fallback adb binary when neither ADB_PATH nor PATH's "adb" can see the
# target device. Defaults to AirDroid Cast's bundled adb, which is what
# works on this dev machine because the device's Windows USB driver is
# bound to it. Machines without AirDroid Cast installed should leave this
# unset or point it elsewhere.
# ADB_FALLBACK_PATH=C:\Program Files (x86)\AirDroid Cast\IncludeAdb\adb_helper.exe

# Serial of the device to target. If unset, the first device adb reports
# in "device" state is used (only safe with exactly one device attached).
# DEVICE_SERIAL=

# Wireless debugging connect address (ip:port) from the phone's
# Settings > Developer options > Wireless debugging screen. Requires
# one-time pairing first via: node scripts/pair-wireless.js <ip:port> <code>
# If unset, adb resolution relies on whatever "adb devices" already sees
# (e.g. USB).
# WIRELESS_ADB_ADDR=

# Local TCP port used for "adb forward" to the on-device scrcpy socket.
SCRCPY_FORWARD_PORT=27183

# Local TCP port used for "adb forward" to the on-device scrcpy control socket.
SCRCPY_CONTROL_PORT=27184

# HTTP/WebSocket port the web app listens on.
WEB_PORT=8000

# --- Video quality vs latency ---
# These two work together. MAX_SIZE caps the longest edge before encoding;
# a phone panel is far taller than any monitor can display, so streaming
# its full height encodes and decodes several times more pixels than are
# ever shown, which costs latency for no visible gain. With the default
# 1600 cap, the 8 Mbps below is spread over ~3.7x fewer pixels than the
# full panel, so it is sharper per pixel than it sounds.
#
# If the view lags behind the phone: lower VIDEO_BIT_RATE (e.g. 6000000),
# or lower MAX_SIZE (e.g. 1200), or cap MAX_FPS (e.g. 30).
# If you want more detail and have bandwidth to spare: raise VIDEO_BIT_RATE.
# VIDEO_BIT_RATE=8000000
# MAX_SIZE=1600
# MAX_FPS=
